@techreport{zarriessDecidableVerificationGolog2015,
  title = {Decidable {{Verification}} of {{Golog Programs}} over {{Non-Local Effect Actions}}},
  author = {Zarrie{\ss}, Benjamin and Cla{\ss}en, Jens},
