@inproceedings{abdulazizVerifiedOverApproximationDiameter2015,
  title = {Verified {{Over-Approximation}} of the {{Diameter}} of {{Propositionally Factored Transition Systems}}},
  booktitle = {The 6th {{International Conference}} on {{Interactive Theorem Proving}} ({{ITP}})},
  author = {Abdulaziz, Mohammad and Gretton, Charles and Norrish, Michael},
  editor = {Urban, Christian and Zhang, Xingyuan},
  year = 2015,
  pages = {1--16},
  address = {Cham},
  doi = {10.1007/978-3-319-22102-1_1},
  abstract = {To guarantee the completeness of bounded model checking (BMC) we require a completeness threshold. The diameter of the Kripke model of the transition system is a valid completeness threshold for BMC of safety properties. The recurrence diameter gives us an upper bound on the diameter for use in practice. Transition systems are usually described using (propositionally) factored representations. Bounds for such lifted representations are calculated in a compositional way, by first identifying and bounding atomic subsystems, and then composing those results according to subsystem dependencies to arrive at a bound for the concrete system. Compositional approaches are invalid when using the diameter to bound atomic subsystems, and valid when using the recurrence diameter. We provide a novel overapproximation of the diameter, called the sublist diameter, that is tighter than the recurrence diameter. We prove that compositional approaches are valid using it to bound atomic subsystems. Those proofs are mechanised in HOL4. We also describe a novel verified compositional bounding technique which provides tighter overall bounds compared to existing bottom-up approaches.},
  isbn = {978-3-319-22102-1},
  langid = {english},
  keywords = {Atomic Subsystem,Bounded Model Checking (BMC),Completeness Threshold,Factored Transition System,Recurrence Diameter},
  file = {/home/mohammad/Zotero/storage/37NWVTH9/Abdulaziz et al. - 2015 - Verified Over-Approximation of the Diameter of Propositionally Factored Transition Systems.pdf}
}

