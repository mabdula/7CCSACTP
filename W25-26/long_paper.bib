@article{banihashemiAbstractionSituationCalculus2017a,
  title = {Abstraction in {{Situation Calculus Action Theories}}},
  author = {Banihashemi, Bita and De Giacomo, Giuseppe and Lesperance, Yves},
  year = 2017,
