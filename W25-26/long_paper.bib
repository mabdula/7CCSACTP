@misc{bernsteinComplexityDecentralizedControl2013,
  title = {The {{Complexity}} of {{Decentralized Control}} of {{Markov Decision Processes}}},
  author = {Bernstein, Daniel S. and Zilberstein, Shlomo and Immerman, Neil},
