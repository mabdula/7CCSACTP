  doi = {10.48550/arXiv.1904.08255},
  urldate = {2023-02-24},
  abstract = {The online matching problem was introduced by Karp, Vazirani and Vazirani nearly three decades ago. In that seminal work, they studied this problem in bipartite graphs with vertices arriving only on one side, and presented optimal deterministic and randomized algorithms for this setting. In comparison, more general arrival models, such as edge arrivals and general vertex arrivals, have proven more challenging and positive results are known only for various relaxations of the problem. In particular, even the basic question of whether randomization allows one to beat the trivially-optimal deterministic competitive ratio of \$\textbackslash frac\textbraceleft 1\textbraceright\textbraceleft 2\textbraceright\$ for either of these models was open. In this paper, we resolve this question for both these natural arrival models, and show the following. 1. For edge arrivals, randomization does not help --- no randomized algorithm is better than \$\textbackslash frac\textbraceleft 1\textbraceright\textbraceleft 2\textbraceright\$ competitive. 2. For general vertex arrivals, randomization helps --- there exists a randomized \$(\textbackslash frac\textbraceleft 1\textbraceright\textbraceleft 2\textbraceright +\textbackslash Omega(1))\$-competitive online matching algorithm.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Data Structures and Algorithms},
  file = {/home/mohammad/Zotero/storage/CKERDGFF/Gamlath et al. - 2019 - Online Matching with General Arrivals.pdf;/home/mohammad/Zotero/storage/CMT4896J/1904.html}
