  author = {Almeida, Jos{\'e} Bacelar and Arranz Olmos, Santiago and Barbosa, Manuel and Barthe, Gilles and Dupressoir, Fran{\c c}ois and Gr{\'e}goire, Benjamin and Laporte, Vincent and L{\'e}chenet, Jean-Christophe and Low, Cameron and Oliveira, Tiago and Pacheco, Hugo and Quaresma, Miguel and Schwabe, Peter and Strub, Pierre-Yves},
