@article{matchingCombGeometry,
  title = {Matching {{Theory}} for {{Combinatorial Geometries}}},
  author = {Aigner, Martin and Dowling, Thomas A.},
  year = 1971,
  journal = {Transactions of the American Mathematical Society},
  volume = {158},
  number = {1},
  eprint = {1995784},
  eprinttype = {jstor},
  pages = {231--245},
  publisher = {American Mathematical Society},
  issn = {0002-9947},
  doi = {10.2307/1995784},
