@inproceedings{hyperGraphs,
  title = {A {{Formalisation}} of the {{Balog}}--{{Szemer\'edi}}--{{Gowers Theorem}} in {{Isabelle}}/{{HOL}}},
  booktitle = {The 12th {{ACM SIGPLAN International Conference}} on {{Certified Programs}} and {{Proofs}} ({{CPP}})},
  author = {{Koutsoukou-Argyraki}, Angeliki and Bak{\v s}ys, Mantas and Edmonds, Chelsea},
